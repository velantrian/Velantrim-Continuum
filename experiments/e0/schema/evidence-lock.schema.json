{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"velantrim-continuum:e0-evidence-lock:v0.1",
  "type":"object",
  "required":["lock_version","status","protocol","schemas","evidence_fixtures","gold_oracle","evaluator","run_config","prompts","randomization","clarification_policy","generator_config","supersession_rule"],
  "properties":{
    "lock_version":{"const":"0.1"},
    "status":{"enum":["DRAFT","EVIDENCE_READY"]},
    "protocol":{"$ref":"#/$defs/versioned_hash"},
    "schemas":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/versioned_hash"}},
    "evidence_fixtures":{"$ref":"#/$defs/versioned_hash"},
    "gold_oracle":{"$ref":"#/$defs/versioned_hash"},
    "evaluator":{"$ref":"#/$defs/versioned_hash"},
    "run_config":{"$ref":"#/$defs/versioned_hash"},
    "prompts":{"type":"array","items":{"$ref":"#/$defs/versioned_hash"}},
    "randomization":{"$ref":"#/$defs/versioned_hash"},
    "clarification_policy":{"$ref":"#/$defs/versioned_hash"},
    "generator_config":{"$ref":"#/$defs/versioned_hash"},
    "supersession_rule":{"$ref":"#/$defs/versioned_hash"},
    "human_gold_approval":{"type":"object","required":["status","approved_by","approved_at"],"properties":{"status":{"enum":["REQUIRED","HUMAN_APPROVED"]},"approved_by":{"type":["string","null"]},"approved_at":{"type":["string","null"]}},"additionalProperties":false}
  },
  "additionalProperties":false,
  "$defs":{"versioned_hash":{"type":"object","required":["version","sha256"],"properties":{"version":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}}
}
